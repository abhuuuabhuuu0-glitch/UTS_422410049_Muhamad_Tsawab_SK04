digraph ERD {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, label=<<B>Entity Relationship Diagram — SK04 Restorasi Pita Analog (MySQL 8)</B><BR/><FONT POINT-SIZE="11">PK = primary key · FK = foreign key · UK = unique key · notasi crow's foot</FONT>>, labelloc=t, pad=0.4, nodesep=0.7, ranksep=1.6, bgcolor="#fffdf7", splines=spline];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#7c4a1e", arrowsize=0.9];

  kategori_pita [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>kategori_pita</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
 <TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">deskripsi</TD><TD ALIGN="LEFT">TEXT NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  pita [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>pita</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">kode_arsip</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR>
 <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">kategori_pita_id</TD><TD ALIGN="LEFT">→ kategori_pita.id</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">judul</TD><TD ALIGN="LEFT">VARCHAR(191)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tahun_rekaman</TD><TD ALIGN="LEFT">SMALLINT UNS NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">durasi_menit</TD><TD ALIGN="LEFT">SMALLINT UNS NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">kondisi</TD><TD ALIGN="LEFT">ENUM(baik,sedang,rusak_berat)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">lokasi_simpan</TD><TD ALIGN="LEFT">VARCHAR(150) NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">deskripsi</TD><TD ALIGN="LEFT">TEXT NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  kerusakan [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>kerusakan</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">deskripsi</TD><TD ALIGN="LEFT">TEXT NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  pita_kerusakan [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#fff7e8">
 <TR><TD BGCOLOR="#fcd34d" COLSPAN="3"><B>pita_kerusakan</B> <FONT POINT-SIZE="9">(pivot)</FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT">pita_id</TD><TD ALIGN="LEFT">→ pita.id CASCADE</TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT">kerusakan_id</TD><TD ALIGN="LEFT">→ kerusakan.id CASCADE</TD></TR>
</TABLE>>];

  teknisi [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>teknisi</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">keahlian</TD><TD ALIGN="LEFT">VARCHAR(150) NULL</TD></TR>
 <TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(150) NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  restorasi [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>restorasi</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">pita_id</TD><TD ALIGN="LEFT">→ pita.id CASCADE</TD></TR>
 <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">teknisi_id</TD><TD ALIGN="LEFT">→ teknisi.id SET NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tanggal_mulai</TD><TD ALIGN="LEFT">DATE</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tanggal_selesai</TD><TD ALIGN="LEFT">DATE NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM(menunggu,proses,selesai,dibatalkan)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">biaya</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">catatan</TD><TD ALIGN="LEFT">TEXT NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  restorasi_detail [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>restorasi_detail</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">restorasi_id</TD><TD ALIGN="LEFT">→ restorasi.id CASCADE</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tahap</TD><TD ALIGN="LEFT">ENUM(pembersihan,pemanggangan,digitasi,editing,verifikasi)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tindakan</TD><TD ALIGN="LEFT">VARCHAR(191)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tanggal</TD><TD ALIGN="LEFT">DATE</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">durasi_menit</TD><TD ALIGN="LEFT">SMALLINT UNS DEFAULT 0</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">hasil</TD><TD ALIGN="LEFT">TEXT NULL</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  peralatan [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#ffffff">
 <TR><TD BGCOLOR="#e8a33d" COLSPAN="3"><FONT COLOR="#2f1d12"><B>peralatan</B></FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED AI</TD></TR>
 <TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">jenis</TD><TD ALIGN="LEFT">ENUM(pemutar,pembersih,digitasi,lainnya)</TD></TR>
 <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP NULL</TD></TR>
</TABLE>>];

  restorasi_peralatan [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7c4a1e" BGCOLOR="#fff7e8">
 <TR><TD BGCOLOR="#fcd34d" COLSPAN="3"><B>restorasi_peralatan</B> <FONT POINT-SIZE="9">(pivot)</FONT></TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT">restorasi_id</TD><TD ALIGN="LEFT">→ restorasi.id CASCADE</TD></TR>
 <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT">peralatan_id</TD><TD ALIGN="LEFT">→ peralatan.id CASCADE</TD></TR>
</TABLE>>];

  // Relasi (crow's foot: ujung "|" = satu, "crow" = banyak)
  kategori_pita -> pita [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];
  pita -> pita_kerusakan [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];
  kerusakan -> pita_kerusakan [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];
  pita -> restorasi [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];
  teknisi -> restorasi [dir=both, arrowtail=tee, arrowhead=crow, label=" 0..1 : N "];
  restorasi -> restorasi_detail [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];
  restorasi -> restorasi_peralatan [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];
  peralatan -> restorasi_peralatan [dir=both, arrowtail=tee, arrowhead=crow, label=" 1 : N "];

  { rank=same; kategori_pita; kerusakan; teknisi; peralatan }
}
